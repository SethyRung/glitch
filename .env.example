# Docker
POSTGRES_USER=admin
POSTGRES_PASSWORD=supersecret
POSTGRES_DB=easyshopdb

# Database
DATABASE_DRIVER=postgres-js
DATABASE_URL=postgresql://admin:supersecret@localhost:5432/easyshopdb

# Redis (NuxtHub KV driver)
REDIS_URL=redis://localhost:6379

# Auth
NUXT_BETTER_AUTH_SECRET=replace-with-a-random-32-character-secret
NUXT_PUBLIC_SITE_URL=http://localhost:3000

NUXT_BRIDGE_SHARED_SECRET=
